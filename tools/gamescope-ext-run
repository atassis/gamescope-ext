#!/usr/bin/env bash
# Runs a game inside gamescope-ext with the settings of a named profile. For Steam launch options:
#
#   gamescope-ext-run %command%                  # profile "default"
#   gamescope-ext-run -p NAME %command%          # or GAMESCOPE_EXT_PROFILE=NAME
#   gamescope-ext-run --scale 3/2 %command%      # any profile key as --KEY VALUE, over the profile
#   gamescope-ext-run -n [-p NAME] <command>     # print the gamescope command line, run nothing
#   gamescope-ext-run --list                     # profiles and installed plugins
#   gamescope-ext-run --help
#
# Profiles are read from $XDG_CONFIG_HOME/gamescope-ext/run.conf (GAMESCOPE_EXT_RUN_CONF overrides);
# run.conf.example next to the installed host documents every key. Installed as <name>-run, it runs
# the <name> it was installed beside unless a profile sets `binary`.
set -euo pipefail

bindir=$(cd "$(dirname "$0")" && pwd)
self=$(basename "$0")
exe=${self%-run}
conf=${GAMESCOPE_EXT_RUN_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/gamescope-ext/run.conf}
profile=${GAMESCOPE_EXT_PROFILE:-default}
dry=0
list=0
keys=' binary filter output scale input sharpness refresh fullscreen hdr args env '
declare -A cli=()

fail() { echo "$self: $*" >&2; exit 1; }

usage() {
	cat <<USAGE
usage: $self [-p PROFILE] [--KEY VALUE ...] [-n] [--] COMMAND [ARGS...]
       $self --list | --help

Runs COMMAND inside $exe, with sizes, filter and the rest taken from PROFILE (default "default")
in $conf. In Steam's launch options: $self %command%

  -p, --profile NAME   use [NAME] (also GAMESCOPE_EXT_PROFILE)
  -n, --dry-run        print the command line instead of running it
  --list               show the profiles, and each installed plugin with its configs, scales
                       and environment switches
  --KEY VALUE          set a profile key for this run, over the config file:
      --output O         your screen: auto (default),  --scale N or N/M   output / game size
                         a name like DP-2, or WxH
      --scale game       the game picks its size in    --filter F         a -F value, e.g. fsr,
                         its own menu (screen = native)
      --input WxH        the game's size, not scale
      --sharpness 0-20   0 is sharpest                    external:<plugin>[:config]
      --refresh HZ       -r; default: the screen's rate  --fullscreen 0|1
      --hdr 0|1          --hdr-enabled                 --args "..."       more gamescope arguments
      --env "A=1 B=2"    environment for the run       --binary NAME      which gamescope to run

{w} and {h} in COMMAND's arguments are replaced by the game size, e.g. %command% -w {w} -h {h}.

The keys and an example config: $(dirname "$bindir")/share/$exe/run.conf.example
USAGE
}

while [ $# -gt 0 ]; do
	case "$1" in
		-h|--help) usage; exit 0 ;;
		-p|--profile) [ $# -ge 2 ] || fail "$1 needs a profile name"; profile=$2; shift 2 ;;
		-n|--dry-run) dry=1; shift ;;
		--list) list=1; shift ;;
		--) shift; break ;;
		--*)
			key=${1#--}
			[[ $keys == *" $key "* ]] || fail "unknown option $1 (see --help)"
			[ $# -ge 2 ] || fail "$1 needs a value"
			cli[$key]=$2
			shift 2
			;;
		*) break ;;
	esac
done

# Plugin directories in the host's own search order (EXTERNAL_UPSCALER.md, Discovery).
plugin_dirs=()
IFS=: read -ra extra_dirs <<<"${GAMESCOPE_UPSCALER_PATH:-}"
plugin_dirs+=("${extra_dirs[@]}" "${XDG_DATA_HOME:-$HOME/.local/share}/gamescope-upscalers"
	"$(dirname "$bindir")/share/gamescope-upscalers")
IFS=: read -ra data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for d in "${data_dirs[@]}"; do plugin_dirs+=("$d/gamescope-upscalers"); done
declare -A seen=()
unique=()
for d in "${plugin_dirs[@]}"; do
	[ -n "$d" ] || continue
	r=$(realpath -m -- "$d")
	[ -n "${seen[$r]:-}" ] || unique+=("$d")
	seen[$r]=1
done
plugin_dirs=("${unique[@]}")

declare -A cfg=([filter]=fsr [scale]=2 [fullscreen]=1)
declare -A set_by_profile=()
sections=()

# run.conf: "[name]" starts a profile, "key = value" sets a key, "#" starts a comment. Keys before
# any section, or in [default], apply to every profile; the chosen profile's keys override them.
if [ -f "$conf" ]; then
	section=default
	found=0
	n=0
	while IFS= read -r line || [ -n "$line" ]; do
		n=$((n + 1))
		line=${line%%#*}
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line%"${line##*[![:space:]]}"}"
		[ -n "$line" ] || continue
		if [[ $line =~ ^\[([A-Za-z0-9._-]+)\]$ ]]; then
			section=${BASH_REMATCH[1]}
			sections+=("$section")
			[ "$section" = "$profile" ] && found=1
			continue
		fi
		[[ $line =~ ^([a-z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || fail "$conf:$n: expected 'key = value' or '[profile]'"
		key=${BASH_REMATCH[1]}
		[[ $keys == *" $key "* ]] || fail "$conf:$n: unknown key '$key'"
		if [ "$section" = default ] || [ "$section" = "$profile" ]; then
			# A profile's own value wins over [default] whichever comes first in the file.
			if [ "$section" = "$profile" ] || [ -z "${set_by_profile[$key]:-}" ]; then
				cfg[$key]=${BASH_REMATCH[2]}
			fi
			[ "$section" = "$profile" ] && [ "$profile" != default ] && set_by_profile[$key]=1
		fi
	done <"$conf"
	[ "$profile" = default ] || [ $found = 1 ] || fail "no [$profile] in $conf"
elif [ "$profile" != default ]; then
	fail "profile '$profile' asked for, but $conf does not exist"
fi

for key in "${!cli[@]}"; do cfg[$key]=${cli[$key]}; done

if [ $list = 1 ]; then
	echo "config: $conf"
	echo "profiles: ${sections[*]:-(none)}"
	for d in "${plugin_dirs[@]}"; do
		for m in "$d"/*/manifest.json; do
			[ -f "$m" ] || continue
			p=$(dirname "$m")
			echo "plugin $(basename "$p")  ($p)"
			if command -v python3 >/dev/null; then
				python3 - "$m" <<'PY' || true
import json, sys
m = json.load(open(sys.argv[1]))
if m.get("description"): print("  " + m["description"])
if m.get("config_help"): print("  config: " + m["config_help"])
for c in m.get("configs", []):
    scales = " ".join(c.get("scales", []))
    print(f"  external:{m.get('name', '?')}:{c['name']}" + (f"  scales {scales}" if scales else "")
          + (f"  -- {c['description']}" if c.get("description") else ""))
for k, v in m.get("env", {}).items():
    print(f"  env {k}: {v}")
PY
			else
				data=$(find "$p" -mindepth 1 -maxdepth 1 -type d -printf '%f ' 2>/dev/null)
				[ -z "$data" ] || echo "  data: $data"
			fi
		done
	done
	exit 0
fi

[ $# -gt 0 ] || fail "no command to run (Steam: put %command% after $self)"

# output: WIDTHxHEIGHT, a connector name (DP-2, eDP-1) for that screen's current mode, or auto (the
# default) for the screen KWin opens new windows on. The names and modes come from kscreen-doctor.
output=${cfg[output]:-auto}
if ! [[ $output =~ ^[0-9]+x[0-9]+$ ]]; then
	name=$output
	if [ "$name" = auto ]; then
		name=$(gdbus call --session --dest org.kde.KWin --object-path /KWin \
			--method org.kde.KWin.activeOutputName 2>/dev/null | sed -n "s/^('\(.*\)',)$/\1/p")
		[ -n "$name" ] || fail "output = auto needs KDE Plasma (KWin); set 'output = WIDTHxHEIGHT' or pass --output"
	fi
	command -v kscreen-doctor >/dev/null && command -v python3 >/dev/null ||
		fail "output = $output needs kscreen-doctor and python3; set 'output = WIDTHxHEIGHT' instead"
	output=$(kscreen-doctor -j 2>/dev/null | python3 -c 'import json,sys
for o in json.load(sys.stdin)["outputs"]:
    if o["name"] == sys.argv[1] and o.get("enabled"):
        m = {m["id"]: m for m in o["modes"]}[o["currentModeId"]]["size"]
        mode = {m["id"]: m for m in o["modes"]}[o["currentModeId"]]
        print(str(m["width"]) + "x" + str(m["height"]), round(mode["refreshRate"]))' "$name") || true
	[ -n "$output" ] || fail "no enabled screen named '$name' (kscreen-doctor -o lists them)"
	# Unless the profile sets refresh, the game's frame-rate target is that screen's refresh rate.
	cfg[refresh]=${cfg[refresh]:-${output#* }}
	output=${output%% *}
fi
[[ $output =~ ^([0-9]+)x([0-9]+)$ ]]
out_w=${BASH_REMATCH[1]}
out_h=${BASH_REMATCH[2]}

if [ -n "${cfg[input]:-}" ]; then
	[[ ${cfg[input]} =~ ^([0-9]+)x([0-9]+)$ ]] || fail "input must be WIDTHxHEIGHT, got '${cfg[input]}'"
	in_w=${BASH_REMATCH[1]}
	in_h=${BASH_REMATCH[2]}
elif [ "${cfg[scale]}" = game ]; then
	# The game sees the whole screen as its native mode and picks its render size in its own menu;
	# gamescope upscales whatever it draws, so the plugin meets the ratio only at run time.
	in_w=$out_w
	in_h=$out_h
else
	[[ ${cfg[scale]} =~ ^([0-9]+)(/([0-9]+))?$ ]] || fail "scale must be N, N/M or game, got '${cfg[scale]}'"
	num=${BASH_REMATCH[1]}
	den=${BASH_REMATCH[3]:-1}
	in_w=$(( (out_w * den + num / 2) / num ))
	in_h=$(( (out_h * den + num / 2) / num ))
fi

# external:<plugin>:<name> with a bare name that is a directory inside the installed plugin's own
# directory becomes that directory's path, so launch options never carry an absolute path.
filter=${cfg[filter]}
if [[ $filter =~ ^external:([^:/]+):([^/]+)$ ]]; then
	for d in "${plugin_dirs[@]}"; do
		if [ -f "$d/${BASH_REMATCH[1]}/manifest.json" ]; then
			manifest=$d/${BASH_REMATCH[1]}/manifest.json
			config=${BASH_REMATCH[2]}
			[ -d "$d/${BASH_REMATCH[1]}/$config" ] &&
				filter="external:${BASH_REMATCH[1]}:$d/${BASH_REMATCH[1]}/$config"
			break
		fi
	done
fi

# A scale the plugin's manifest does not list for this config is declined at run time, and
# gamescope then upscales with its own FSR1: say so now rather than only in its log.
scale=${cfg[scale]}
[ "$scale" != game ] || scale=
if [ -n "${cfg[input]:-}" ]; then
	# The scale an input size implies, as a reduced fraction, or nothing when the axes differ.
	a=$out_w; b=$in_w
	while [ "$b" -ne 0 ]; do t=$((a % b)); a=$b; b=$t; done
	scale=$((out_w / a))/$((in_w / a))
	[ $((out_w * in_h)) -eq $((out_h * in_w)) ] || scale=
	[ "${scale#*/}" != 1 ] || scale=${scale%/1}
fi
if [ -n "${manifest:-}" ] && [ -n "$scale" ] && command -v python3 >/dev/null; then
	listed=$(python3 -c 'import json,sys
for c in json.load(open(sys.argv[1])).get("configs", []):
    if c.get("name") == sys.argv[2]: print(" ".join(c.get("scales", [])))' "$manifest" "$config" 2>/dev/null || true)
	if [ -n "$listed" ] && [[ " $listed " != *" $scale "* ]]; then
		echo "$self: warning: $config lists scales $listed, not $scale; gamescope will use its own FSR1" >&2
	fi
fi

binary=${cfg[binary]:-$exe}
if [[ $binary != */* ]]; then
	if [ -x "$bindir/$binary" ]; then
		binary=$bindir/$binary
	else
		binary=$(command -v "$binary") || fail "'${cfg[binary]:-$exe}' not found beside $self or on PATH"
	fi
fi

cmd=("$binary" -w "$in_w" -h "$in_h" -W "$out_w" -H "$out_h" -F "$filter")
[ "${cfg[fullscreen]}" = 1 ] && cmd+=(-f)
[ -n "${cfg[refresh]:-}" ] && cmd+=(-r "${cfg[refresh]}")
[ -n "${cfg[sharpness]:-}" ] && cmd+=(--sharpness "${cfg[sharpness]}")
[ "${cfg[hdr]:-0}" = 1 ] && cmd+=(--hdr-enabled)
if [ -n "${cfg[args]:-}" ]; then
	read -ra more <<<"${cfg[args]}"
	cmd+=("${more[@]}")
fi
# {w} and {h} in the game's own arguments become the game size chosen above.
game=()
for a in "$@"; do a=${a//\{w\}/$in_w}; game+=("${a//\{h\}/$in_h}"); done
cmd+=(-- "${game[@]}")

envs=()
if [ -n "${cfg[env]:-}" ]; then
	read -ra envs <<<"${cfg[env]}"
	for kv in "${envs[@]}"; do
		[[ $kv =~ ^[A-Za-z_][A-Za-z0-9_]*=.*$ ]] || fail "env entries must be NAME=value, got '$kv'"
	done
fi

if [ $dry = 1 ]; then
	printf '%s' "${envs[*]:+${envs[*]} }"
	printf '%q ' "${cmd[@]}"
	echo
	exit 0
fi
exec env "${envs[@]}" "${cmd[@]}"
