#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set.h"

layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

// Raw texel copy of layer 0 into dst at 1:1, no colour management: an external upscaler's BGRA8 plane.
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coord, imageSize(dst))))
        return;

    imageStore(dst, coord, texelFetch(s_samplers[0], coord, 0));
}
